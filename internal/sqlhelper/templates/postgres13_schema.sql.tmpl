{{range .Schemas}}GRANT USAGE ON SCHEMA {{.}} TO {{$.User}};
GRANT SELECT ON ALL TABLES IN SCHEMA {{.}} TO {{$.User}};
GRANT SELECT ON ALL SEQUENCES IN SCHEMA {{.}} TO {{$.User}};
ALTER DEFAULT PRIVILEGES FOR ROLE {{$.OwnerRole}} IN SCHEMA {{.}} GRANT SELECT ON TABLES TO {{$.User}};
ALTER DEFAULT PRIVILEGES FOR ROLE {{$.OwnerRole}} IN SCHEMA {{.}} GRANT SELECT ON SEQUENCES TO {{$.User}};
{{end}}
